# Settings for scripts/deploy.sh. Copy to .env, fill in, then `set -a; source .env; set +a`.

# Network: sepolia | mainnet | devnet, or set RPC_URL instead
NETWORK="sepolia"
RPC_URL=""

# sncast account name (from `sncast account create/import`), or a starkli
# account file path together with KEYSTORE
ACCOUNT=""
ACCOUNTS_FILE=""
KEYSTORE=""

# Token (deploy only)
TOKEN_ADMIN=""
TOKEN_NAME=""
TOKEN_SYMBOL=""
TOKEN_DECIMALS="0"

# Extra information (all presets except light)
TOKEN_ID=""
TERMS_NAME=""
TERMS_URI=""
TERMS_HASH="0x0"
TOKEN_INFORMATION=""

# standard, debt and snapshot only; 0x0 means no RuleEngine
RULE_ENGINE="0x0"
